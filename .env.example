# ElderSOS Environment Configuration
SECRET_KEY=eldersos-secure-session-key-change-in-production-2026
DATABASE_URL=sqlite:///eldersos.db

# Alert Mode: 'test' (logs to console/UI only) or 'live' (delivers via Telegram/Twilio)
ALERT_MODE=test

# Primary Alert Provider in live mode: 'telegram', 'twilio', or 'console'
ALERT_PROVIDER=telegram

# Telegram Bot Integration (Required if ALERT_PROVIDER=telegram and ALERT_MODE=live)
# Create a bot via @BotFather on Telegram to get your bot token
TELEGRAM_BOT_TOKEN=

# Twilio SMS Integration (Optional, required if ALERT_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
